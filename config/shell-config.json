{
	"topBar": {
		"position": "top",
		"height": 40,
		"transparency": 0.9,
		"leftWidgets": ["workspaces"],
		"centerWidgets": ["idle-icon", "clock-date", "weather", "media"],
		"rightWidgets": [
			"cpu-temp",
			"cpu-usage",
			"ram-usage",
			"battery",
			"power-menu"
		]
	},
	"dock": {
		"position": "bottom",
		"iconSize": 48,
		"autoHide": false,
		"leftWidgets": ["open-apps"],
		"rightWidgets": ["language", "network"]
	},
	"keybinds": {
		"launcher": "SUPER, S",
		"screenshot": "SUPER SHIFT, S",
		"clipboard": "SUPER, V"
	},
	"notifications": {
		"enabled": [
			"battery-low",
			"software-updates",
			"calendar-events",
			"messages",
			"device-connected",
			"screenshot-saved",
			"volume-change",
			"brightness-change",
			"network-status"
		]
	}
}
